{
  "name": "dsh-plugin-questbranch",
  "version": "0.1.0-dev.2",
  "description": "Branching research workspace inside DeepSeek Harness",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "chunks",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "CHANGELOG.md",
    "docs/development.md",
    "docs/troubleshooting.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-decoy/QuestBranch-DSH.git"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "research", "mindmap", "questbranch"],
  "license": "MIT",
  "homepage": "https://github.com/Ethan-decoy/QuestBranch-DSH#readme",
  "bugs": {
    "url": "https://github.com/Ethan-decoy/QuestBranch-DSH/issues"
  }
}
