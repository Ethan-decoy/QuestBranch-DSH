{
  "name": "questbranch-dsh",
  "version": "0.1.0-dev.2",
  "private": true,
  "type": "module",
  "description": "Branching research workspace for DeepSeek Harness",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm i18n:check && pnpm typecheck && pnpm test",
    "build": "pnpm typecheck && node scripts/build-dsh.mjs",
    "build:dsh": "pnpm build",
    "pack:dsh": "pnpm build && node scripts/pack-dsh.mjs",
    "format": "prettier --write src tests config scripts *.ts *.json *.yaml *.md .github docs",
    "format:check": "prettier --check src tests config scripts *.ts *.json *.yaml *.md .github docs",
    "notices": "node scripts/dsh-notices.mjs",
    "notices:check": "node scripts/dsh-notices.mjs --check",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci && i18next-cli status && i18next-cli lint"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "i18next": "26.7.1",
    "lucide-react": "1.57.0",
    "proper-lockfile": "4.1.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "i18next-cli": "1.82.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-decoy/QuestBranch-DSH.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/Ethan-decoy/QuestBranch-DSH#readme",
  "bugs": {
    "url": "https://github.com/Ethan-decoy/QuestBranch-DSH/issues"
  }
}
